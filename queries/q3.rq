PREFIX : <http://example.org/kg/23p-0032/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?person1 ?person1Name ?person2 ?person2Name ?sharedBirthplace ?birthplaceName
WHERE {
    ?person1 :bornIn ?sharedBirthplace .
    ?person2 :bornIn ?sharedBirthplace .
    FILTER (STR(?person1) < STR(?person2))
    OPTIONAL { ?person1 rdfs:label ?person1Name }
    OPTIONAL { ?person2 rdfs:label ?person2Name }
    OPTIONAL { ?sharedBirthplace rdfs:label ?birthplaceName }
}
ORDER BY ?sharedBirthplace ?person1
